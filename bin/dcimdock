#!/usr/bin/env bash
# Launcher: prefers a local virtualenv, falls back to the system PySide6.
# The terminal mode (--cli) needs no PySide6 at all.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

if [[ -x "$here/.venv/bin/python" ]]; then
    exec "$here/.venv/bin/python" -m dcimdock "$@"
fi

if [[ " $* " != *" --cli "* ]] && ! python3 -c "import PySide6.QtWidgets" 2>/dev/null; then
    echo "dcimdock: PySide6 is missing. Install it with:  sudo dnf install python3-pyside6  (Debian/Ubuntu: sudo apt install python3-pyside6.qtwidgets)" >&2
    command -v kdialog >/dev/null && kdialog --error "PySide6 is missing.\n\nsudo dnf install python3-pyside6  (Debian/Ubuntu: sudo apt install python3-pyside6.qtwidgets)" || true
    exit 1
fi

cd "$here"
exec python3 -m dcimdock "$@"
